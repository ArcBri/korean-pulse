# Copy to .env.local for local API testing, and set the same keys in Vercel.

# Generate with: npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Upstash Redis (free tier) — https://upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret for /api/push/cron (GitHub Actions + optional manual curl)
CRON_SECRET=
