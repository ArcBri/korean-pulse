# Copy to .env.local for local API testing, and set the same keys in Vercel.

# Public feedback destination (mailto fallback + API "to" address).
NEXT_PUBLIC_FEEDBACK_EMAIL=tarantadonatarantula@gmail.com

# Optional server-only override for the inbox (defaults to NEXT_PUBLIC_FEEDBACK_EMAIL).
# FEEDBACK_TO_EMAIL=tarantadonatarantula@gmail.com

# Resend (Settings → Feedback in-app send). Never commit real keys.
# Create at https://resend.com → API Keys
RESEND_API_KEY=

# Verified From address in Resend.
# Dev/testing: Hangul Hour <onboarding@resend.dev> (can only send to your Resend account email)
# Production: verify a domain in Resend, then e.g. Hangul Hour <feedback@yourdomain.com>
FEEDBACK_FROM_EMAIL=Hangul Hour <onboarding@resend.dev>

# Generate with: npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# IMPORTANT for iPhone: must be `mailto:you@email.com` or `https://your-domain`
# (bare emails are auto-prefixed; invalid subjects cause Apple 403 BadJwtToken)

# Upstash Redis (free tier) — https://upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret for /api/push/cron (GitHub Actions + optional manual curl)
CRON_SECRET=
